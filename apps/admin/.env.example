# Copy this file to .env.local and fill in real values.
# NEVER commit the resulting .env.local file.
#
# This app is deployed SEPARATELY from apps/frontend — recommended as its
# own subdomain (e.g. admin.beautybook.no) with additional network-level
# restrictions (IP allowlist / VPN / SSO), not just a route inside the
# public site. See beautybook-security-measures.md §2, §4, §21.

# Public — exposed to the browser. Do not put secrets here.
# Must point at the backend's /api/admin/* surface, never /api/tenant/*.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/admin
