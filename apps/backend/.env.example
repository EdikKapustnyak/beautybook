# Copy this file to .env and fill in real, environment-specific values.
# NEVER commit the resulting .env file. See root .gitignore.

NODE_ENV=development
PORT=4000

# MongoDB / Redis
MONGODB_URI=mongodb://localhost:27017/beautybook_dev
REDIS_URL=redis://localhost:6379

# Tenant auth secrets — generate with e.g. `openssl rand -hex 32`.
# Must differ from the ADMIN_* secrets below.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

PUBLIC_BOOKING_TOKEN_SECRET=

# Platform admin auth secrets — must be distinct from tenant secrets,
# and use a separate cookie name / session store in code (later stage).
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=

# Token lifetimes (seconds). Defaults are sane for most deployments —
# override only if you have a specific reason to.
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
ADMIN_JWT_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_JWT_REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_BUSINESS=
# Optional — defaults to the production domain if unset.
STRIPE_CHECKOUT_SUCCESS_URL=https://beautybook.no/dashboard/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://beautybook.no/dashboard/billing?checkout=cancelled

# SMS provider (e.g. Twilio, Vonage)
# SMS provider — 'console' logs to stdout in development (no real SMS
# sent, no account needed) — good default for local dev. Switch to
# 'twilio' and fill in the TWILIO_* values to send real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP (phone verification)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Base URL of the public-facing site — used to build booking-management
# links sent in SMS confirmations. No trailing slash. Defaults to the
# production domain if unset; override for staging/local.
PUBLIC_SITE_BASE_URL=https://beautybook.no

# Object storage — S3-compatible. For local dev with the docker-compose
# MinIO service, use the values below as-is. For AWS S3, omit S3_ENDPOINT
# and S3_FORCE_PATH_STYLE, and set S3_PUBLIC_BASE_URL to your CDN/bucket
# public URL.
S3_BUCKET=beautybook-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/beautybook-dev

# Max upload sizes (bytes) and retention for temporary booking photos.
PORTFOLIO_IMAGE_MAX_SIZE_BYTES=5242880
BOOKING_ATTACHMENT_MAX_SIZE_BYTES=8388608
BOOKING_ATTACHMENT_RETENTION_DAYS=30

# Comma-separated list of allowed origins for the PUBLIC/tenant surface.
# Never "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of allowed origins for the PLATFORM ADMIN surface
# only (apps/admin). Deliberately separate from CORS_ALLOWED_ORIGINS.
# Never "*" in production.
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3100
